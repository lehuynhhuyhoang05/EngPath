{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint App.tsx index.ts src -- --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bundle:android": "expo export --platform android --output-dir dist/android",
    "bundle:web": "expo export --platform web --output-dir dist/web"
  },
  "private": true
}
